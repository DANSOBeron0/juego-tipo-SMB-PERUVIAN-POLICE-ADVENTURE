# Auto detect text files and perform LF normalization
* text=auto

# Force LF line endings for text files
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.cmake text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.bat text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.exe binary
*.dll binary
*.lib binary
*.obj binary
*.o binary
*.so binary
*.dylib binary

